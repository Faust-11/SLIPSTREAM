  "claims": [
    {
      "id": "c1",
      "section": "basics",
      "text": "Ничья по очкам в чемпионате решается числом побед, затем вторых мест и т.д.",
      "sources": [
        "s3",
        "s26"
      ],
      "status": "ok"
    },
    {
      "id": "c2",
      "section": "basics",
      "text": "Дистанция ГП — минимальное число полных кругов > 305 км; Монако — 260 км",
      "sources": [
        "s1",
        "s7"
      ],
      "status": "ok"
    },
    {
      "id": "c3",
      "section": "basics",
      "text": "Лимит гонки 2 часа; время остановки под красным флагом не входит",
      "sources": [
        "s1",
        "s7"
      ],
      "status": "ok"
    },
    {
      "id": "c4",
      "section": "basics",
      "text": "Старт — п’ять червоних вогнів, по одному щосекунди; гаснуть — старт (B5.7.2)",
      "sources": [
        "s1",
        "s32"
      ],
      "status": "ok"
    },
    {
      "id": "c5",
      "section": "weekend",
      "text": "Обычный уикенд: FP1, FP2 — пт; FP3, квалификация — сб; гонка — вс",
      "sources": [
        "s1",
        "s7"
      ],
      "status": "ok"
    },
    {
      "id": "c6",
      "section": "weekend",
      "text": "Спринт-уикенд: FP1 + спринт-квалификация — пт; спринт + квалификация — сб; гонка — вс",
      "sources": [
        "s1",
        "s8"
      ],
      "status": "ok"
    },
    {
      "id": "c7",
      "section": "weekend",
      "text": "Q1 18 хв, Q2 15 хв, Q3 13 хв (B2.4.2c, Iss 09; у макеті було 12 — виправлено)",
      "sources": [
        "s1",
        "s2",
        "s7",
        "s28"
      ],
      "status": "ok"
    },
    {
      "id": "c8",
      "section": "weekend",
      "text": "При 22 машинах после Q1 и Q2 выбывают по 6 (места 17–22 и 11–16)",
      "sources": [
        "s1",
        "s7"
      ],
      "status": "ok"
    },
    {
      "id": "c9",
      "section": "weekend",
      "text": "Спринт-квалификация 12/10/8 мин",
      "sources": [
        "s1",
        "s8"
      ],
      "status": "ok"
    },
    {
      "id": "c10",
      "section": "points",
      "text": "Очки ГП 25-18-15-12-10-8-6-4-2-1",
      "sources": [
        "s3",
        "s7"
      ],
      "status": "ok"
    },
    {
      "id": "c11",
      "section": "points",
      "text": "Спринт: 8…1 для первой восьмёрки",
      "sources": [
        "s3",
        "s8"
      ],
      "status": "ok"
    },
    {
      "id": "c12",
      "section": "points",
      "text": "Максимум 25 за уикенд или 33 со спринтом",
      "sources": [
        "s3",
        "s8"
      ],
      "status": "ok"
    },
    {
      "id": "c13",
      "section": "points",
      "text": "Очка за быстрейший круг нет",
      "sources": [
        "s3",
        "s12",
        "s16"
      ],
      "status": "ok"
    },
    {
      "id": "c14",
      "section": "tyres",
      "text": "Поставщик — Pirelli (единый)",
      "sources": [
        "s1",
        "s22"
      ],
      "status": "ok"
    },
    {
      "id": "c15",
      "section": "tyres",
      "text": "5 типов: H белые, M жёлтые, S красные, Inter зелёные, Wet синие",
      "sources": [
        "s22",
        "s19",
        "s1"
      ],
      "status": "ok"
    },
    {
      "id": "c16",
      "section": "tyres",
      "text": "Intermediate — для лёгкого дождя / подсыхающей трассы; Wet — для сильного дождя",
      "sources": [
        "s25",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c17",
      "section": "tyres",
      "text": "Сухих составов в 2026 — пять, C1–C5",
      "sources": [
        "s21",
        "s22"
      ],
      "status": "one"
    },
    {
      "id": "c18",
      "section": "tyres",
      "text": "На каждый ГП Pirelli выбирает три состава из пяти",
      "sources": [
        "s1",
        "s24"
      ],
      "status": "ok"
    },
    {
      "id": "c19",
      "section": "tyres",
      "text": "Сузука 2026 = C1, C2, C3",
      "sources": [
        "s6",
        "s13",
        "s23"
      ],
      "status": "ok"
    },
    {
      "id": "c20",
      "section": "tyres",
      "text": "В сухой гонке обязательно два разных сухих состава",
      "sources": [
        "s1",
        "s33"
      ],
      "status": "ok"
    },
    {
      "id": "c21",
      "section": "tyres",
      "text": "Правило двох складів не діє, якщо пілот у гонці їхав на проміжних або дощових шинах (B6.3.6)",
      "sources": [
        "s1",
        "s33"
      ],
      "status": "ok"
    },
    {
      "id": "c22",
      "section": "tyres",
      "text": "Мягкие быстрее, но изнашиваются раньше; твёрдые медленнее, но живут дольше",
      "sources": [
        "s25"
      ],
      "status": "one"
    },
    {
      "id": "c23",
      "section": "tyres",
      "text": "Спринт-квалификация: medium в SQ1–SQ2, soft в SQ3",
      "sources": [
        "s1",
        "s8"
      ],
      "status": "ok"
    },
    {
      "id": "c24",
      "section": "flags",
      "text": "Маршалы показывают флаги; световые панели дублируют сигналы",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c25",
      "section": "flags",
      "text": "Зелёный: трасса свободна; в начале сессии и после зоны жёлтых",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c26",
      "section": "flags",
      "text": "Жёлтый: опасность у трассы/частично на ней; сбросить, не обгонять",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c27",
      "section": "flags",
      "text": "Двойной жёлтый: трасса заблокирована / работают маршалы; сильно сбросить, готовность остановиться",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c28",
      "section": "flags",
      "text": "Красный: сессия остановлена; в гонке все медленно едут на пит-лейн и ждут",
      "sources": [
        "s5",
        "s1",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c29",
      "section": "flags",
      "text": "Синій прапор: вас наздоганяють на коло — пропустіть; за ігнорування можливий штраф",
      "sources": [
        "s5",
        "s9",
        "s27"
      ],
      "status": "ok"
    },
    {
      "id": "c30",
      "section": "flags",
      "text": "Белый: впереди значительно более медленный автомобиль",
      "sources": [
        "s5",
        "s9",
        "s27"
      ],
      "status": "ok"
    },
    {
      "id": "c31",
      "section": "flags",
      "text": "Жёлтый с красными полосами: скользко (масло/вода)",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c32",
      "section": "flags",
      "text": "Чёрно-белый диагональный: предупреждение за неспортивное поведение, с номером пилота",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c33",
      "section": "flags",
      "text": "Чёрный с оранжевым кругом: опасная техническая неисправность, срочно в боксы",
      "sources": [
        "s5",
        "s9"
      ],
      "status": "ok"
    },
    {
      "id": "c34",
      "section": "flags",
      "text": "Чёрный: дисквалификация, сразу вернуться в гараж",
      "sources": [
        "s9",
        "s27",
        "s5"
      ],
      "status": "ok"
    },
    {
      "id": "c35",
      "section": "flags",
      "text": "Клетчатый: конец сессии/гонки; машут, пока все не пересекут линию",
      "sources": [
        "s5",
        "s9",
        "s1"
      ],
      "status": "ok"
    },
    {
      "id": "c36",
      "section": "overtake",
      "text": "Болиды 2026: подвижные крылья спереди и сзади + батарея, которой управляет пилот",
      "sources": [
        "s1",
        "s4",
