{
  "name": "outlap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/dev/clear-fetch-cache.mjs && next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "glossary:report": "GLOSSARY_REPORT=1 vitest run src/lib/glossary/__tests__/report.test.ts --reporter=dot",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs",
    "db:fake": "node scripts/dev/fake-postgrest.mjs"
  },
  "dependencies": {
    "jose": "6.2.15",
    "next": "16.4.5",
    "oauth4webapi": "3.8.8",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "29.1.1",
    "lighthouse": "13.6.0",
    "playwright-core": "1.65.1",
    "puppeteer-core": "25.18.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
