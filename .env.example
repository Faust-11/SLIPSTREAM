# Скопіюйте у .env.local і заповніть. Значення не комітити.
# Індексація пошуковиками: "on" лише після запуску (до того — noindex). Діє лише в продакшн-оточенні Vercel.
# SITE_URL і SITE_INDEXING читаються під час збірки — після зміни потрібен redeploy.
SITE_INDEXING=

# Базова адреса сайту для canonical/hreflang/sitemap (на Vercel за замовчуванням — продакшн-домен проєкту).
SITE_URL=

# Дані сайту — Supabase (схема f1), лише читання (ключ anon; RLS). Читаються під час збірки, на сервері.
# Локально без Supabase: `npm run db:fake` (фікстура e2e/fixtures/db) і SUPABASE_URL=http://127.0.0.1:54321, SUPABASE_ANON_KEY=test-anon.
SUPABASE_URL=
SUPABASE_ANON_KEY=
